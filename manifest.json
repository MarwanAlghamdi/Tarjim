{
  "manifest_version": 3,
  "name": "Ollama Arabic Translator",
  "version": "0.1.0",
  "description": "Select text anywhere and translate it to Arabic with your local Ollama server.",
  "minimum_chrome_version": "126",
  "icons": {
    "16": "src/icons/icon16.png",
    "32": "src/icons/icon32.png",
    "48": "src/icons/icon48.png",
    "128": "src/icons/icon128.png"
  },
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Ollama Arabic Translator",
    "default_popup": "src/popup/popup.html"
  },
  "options_page": "src/options/options.html",
  "permissions": ["storage", "contextMenus", "activeTab", "tabs", "scripting"],
  "host_permissions": ["http://localhost/*", "http://127.0.0.1/*"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "src/content/ns.js",
        "src/content/styles.js",
        "src/content/ui.js",
        "src/content/main.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["src/pdfjs/*", "src/pdf/*", "src/content/*", "src/icons/*"],
      "matches": ["<all_urls>"]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "commands": {
    "translate-selection": {
      "suggested_key": { "default": "Alt+T" },
      "description": "Translate the current selection to Arabic"
    }
  }
}
